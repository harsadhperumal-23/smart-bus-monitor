# Smart Bus Monitor - Backend Environment Variables
# Copy this file to .env and fill in the values

# Port for the Express server to run on (Render will auto-assign this in production, but you can set a default for local dev)
PORT=5000

# MongoDB Connection String (e.g., MongoDB Atlas URI in production, local URI for development)
# Example (Local): mongodb://localhost:27017/smart-bus
# Example (Atlas): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-bus?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/smart-bus

# Secret key for Express sessions
# Generate a strong random string for production
SESSION_SECRET=supersecretkey_smart_bus_monitor_2024

# The URL of the allowed frontend client (for CORS)
# Example (Local): http://localhost:3000
# Example (Vercel): https://your-frontend.vercel.app
CLIENT_URL=http://localhost:3000

# Environment Mode
# Set to 'production' when deploying (Render will likely set this automatically)
NODE_ENV=development
